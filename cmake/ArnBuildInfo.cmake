# Writes the build identity header used by `arn --version`.
#
# Script mode, run on every build (and once at configure time):
#   cmake -DSOURCE_DIR=<ARN source> -DOUTPUT=<header> [-DGIT_EXECUTABLE=<git>]
#         [-DEXPLICIT_COMMIT=<sha>] -P ArnBuildInfo.cmake
#
# The commit comes from, in order:
#   1. EXPLICIT_COMMIT (the ARN_BUILD_COMMIT cache variable), for builds from
#      a source archive or other packaging without Git;
#   2. `git rev-parse HEAD`, only when SOURCE_DIR is itself the top of a Git
#      work tree (a source copy inside some other repository must not report
#      that repository's commit);
#   3. GITHUB_SHA, when running in GitHub Actions without Git;
#   4. otherwise "unknown". A missing Git never fails the build.
# "-dirty" is added only for local Git builds whose tracked files differ from
# HEAD. Untracked files are ignored, and dirty state is never reported in
# GitHub Actions, where the checkout is clean by construction.
# The header is rewritten only when its content changes, so an unchanged
# identity does not cause recompilation.

cmake_minimum_required(VERSION 3.20)

if (NOT SOURCE_DIR OR NOT OUTPUT)
    message(FATAL_ERROR "ArnBuildInfo.cmake needs SOURCE_DIR and OUTPUT.")
endif()

set(_commit "")
set(_dirty FALSE)
set(_in_github_actions FALSE)
if ("$ENV{GITHUB_ACTIONS}" STREQUAL "true")
    set(_in_github_actions TRUE)
endif()

if (NOT "${EXPLICIT_COMMIT}" STREQUAL "")
    string(TOLOWER "${EXPLICIT_COMMIT}" _explicit)
    if (NOT _explicit MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "ARN_BUILD_COMMIT must be a hexadecimal Git commit SHA, got '${EXPLICIT_COMMIT}'.")
    endif()
    string(LENGTH "${_explicit}" _length)
    if (_length LESS 12 OR _length GREATER 40)
        message(FATAL_ERROR "ARN_BUILD_COMMIT must have 12 to 40 hexadecimal digits, got '${EXPLICIT_COMMIT}'.")
    endif()
    set(_commit "${_explicit}")
elseif (GIT_EXECUTABLE AND EXISTS "${GIT_EXECUTABLE}")
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --show-toplevel
        RESULT_VARIABLE _toplevel_result
        OUTPUT_VARIABLE _toplevel
        ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
    if (_toplevel_result EQUAL 0)
        file(REAL_PATH "${_toplevel}" _toplevel)
        file(REAL_PATH "${SOURCE_DIR}" _source)
        if (CMAKE_HOST_WIN32)
            string(TOLOWER "${_toplevel}" _toplevel)
            string(TOLOWER "${_source}" _source)
        endif()
        if (_toplevel STREQUAL _source)
            execute_process(
                COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --verify HEAD
                RESULT_VARIABLE _head_result
                OUTPUT_VARIABLE _head
                ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
            string(TOLOWER "${_head}" _head)
            if (_head_result EQUAL 0 AND _head MATCHES "^[0-9a-f]+$")
                set(_commit "${_head}")
                if (NOT _in_github_actions)
                    execute_process(
                        COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" status --porcelain
                                --untracked-files=no
                        RESULT_VARIABLE _status_result
                        OUTPUT_VARIABLE _status
                        ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
                    # Only a successful status may mark the build dirty.
                    if (_status_result EQUAL 0 AND NOT _status STREQUAL "")
                        set(_dirty TRUE)
                    endif()
                endif()
            endif()
        endif()
    endif()
endif()

if (_commit STREQUAL "" AND _in_github_actions)
    string(TOLOWER "$ENV{GITHUB_SHA}" _github_sha)
    if (_github_sha MATCHES "^[0-9a-f]+$")
        set(_commit "${_github_sha}")
    endif()
endif()

if (_commit STREQUAL "")
    set(_short "unknown")
else()
    string(SUBSTRING "${_commit}" 0 12 _short)
    if (_dirty)
        string(APPEND _short "-dirty")
    endif()
endif()

set(_content "// Generated by cmake/ArnBuildInfo.cmake. Do not edit.\n#pragma once\n#define ARN_BUILD_COMMIT \"${_short}\"\n")
set(_existing "")
if (EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" _existing)
    string(REPLACE "\r\n" "\n" _existing "${_existing}")
endif()
if (NOT _existing STREQUAL _content)
    get_filename_component(_output_dir "${OUTPUT}" DIRECTORY)
    file(MAKE_DIRECTORY "${_output_dir}")
    file(WRITE "${OUTPUT}" "${_content}")
endif()
