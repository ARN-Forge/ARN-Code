// Version resource of the tests/ide_package_fixture.cpp builds, configured by
// CMake (@ARN_FIXTURE_RC_VERSION@ is the ProductVersion and FileVersion text).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,0,0,0
 PRODUCTVERSION 0,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName", "ARN IDE"
            VALUE "ProductVersion", "@ARN_FIXTURE_RC_VERSION@"
            VALUE "FileVersion", "@ARN_FIXTURE_RC_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
